# Example environment variables for PFM MCP Server
# Copy this file to .env and fill in your actual values

# Required: Your Google Spreadsheet ID (found in the URL)
# Example: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id-here"

# Authentication — pick ONE method:
#
# Option A: Service account (recommended for Docker / headless deployment)
# Either pass the JSON key as a base64-encoded string (best for remote/cloud):
GOOGLE_SERVICE_ACCOUNT_JSON_B64=""
# Or set a file path (for local Docker with mounted secrets):
GOOGLE_SERVICE_ACCOUNT_FILE=""
#
# Option B: OAuth user credentials (for local development)
GOOGLE_CREDENTIALS_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"

# Server transport configuration
# "stdio" for local MCP client integration (default), "sse" for remote/Docker
MCP_TRANSPORT="stdio"
MCP_HOST="0.0.0.0"
MCP_PORT="8000"
