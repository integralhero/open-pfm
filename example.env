# Example environment variables for PFM MCP Server
# Copy this file to .env and fill in your actual values

# Required: Your Google Spreadsheet ID (found in the URL)
# Example: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id-here"

# Authentication (cloud / Docker only):
# Base64-encoded service account JSON key.  For local use, just drop the
# credentials file (OAuth client secrets or service account key) as
# credentials.json in the project root instead.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=""

# Server transport configuration
# "stdio" for local MCP client integration (default), "sse" for remote/Docker
MCP_TRANSPORT="stdio"
MCP_HOST="0.0.0.0"
MCP_PORT="8000"

# Bearer token authentication (remote/Docker only):
# When set and running in HTTP transport mode, all requests must include
# an "Authorization: Bearer <token>" header.  Leave unset for local stdio
# usage or if your deployment is already behind an authenticating proxy.
# MCP_AUTH_TOKEN="some-long-random-secret"
